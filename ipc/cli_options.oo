// # Disk Usage Command-Line Options Parser
//
// Logline: Parses command-line arguments into structured DuOpts configuration.
//
// Setup: Strictly checks flags, depth limits, block sizes, and path operands.
//
// Beats:
//   1. Initialize default DuOpts configuration.
//   2. Iterate argument tokens identifying options and values.
//   3. Extract path operands into target list for traversal.

import "core/du_types.oo";

fn parse_int_from_str(s: String) -> Int {
    let mut res: Int = 0;
    let mut i: Int = 0;
    let s_len: Int = chars_len(s);
    while i < s_len {
        let b: Int = byte_at(s, i);
        if b >= 48 && b <= 57 {
            res = res * 10 + (b - 48);
        }
        i = i + 1;
    }
    return res;
}

pub fn parse_cli_options(args: List[String]) -> DuOpts {
    let mut opts: DuOpts = default_du_opts();
    let num_args: Int = list_len(args);
    let mut i: Int = 0;

    while i < num_args {
        let arg: String = list_get(args, i);

        if arg == "-h" || arg == "--human-readable" {
            opts.human_readable = true;
        } else if arg == "-s" || arg == "--summarize" {
            opts.summarize = true;
        } else if arg == "-a" || arg == "--all" {
            opts.all_files = true;
        } else if arg == "--apparent-size" {
            opts.apparent_size = true;
        } else if arg == "--inodes" {
            opts.show_inodes = true;
        } else if arg == "-k" {
            opts.block_size = 1024;
        } else if arg == "-m" {
            opts.block_size = 1048576;
        } else if arg == "-b" {
            opts.block_size = 1;
        } else if arg == "--sort" {
            opts.sort_by_size = true;
        } else if arg == "-j" || arg == "--json" {
            opts.json_mode = true;
        } else if arg == "-D" || arg == "--demo" {
            opts.demo_mode = true;
        } else if arg == "--mcp" {
            opts.mcp_mode = true;
            return opts;
        } else if arg == "-v" || arg == "--version" {
            opts.show_version = true;
            return opts;
        } else if arg == "--help" {
            opts.show_help = true;
            return opts;
        } else if arg == "-d" || arg == "--max-depth" {
            if i + 1 < num_args {
                i = i + 1;
                opts.max_depth = parse_int_from_str(list_get(args, i));
            }
        } else if arg == "--top" {
            if i + 1 < num_args {
                i = i + 1;
                opts.top_limit = parse_int_from_str(list_get(args, i));
            }
        } else if str_slice(arg, 0, 1) != "-" {
            opts.paths = list_push(opts.paths, arg);
        }

        i = i + 1;
    }

    if list_len(opts.paths) == 0 {
        opts.paths = list_push(opts.paths, ".");
    }

    return opts;
}
