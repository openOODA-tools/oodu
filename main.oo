// # oodu Main Entry Point
//
// Logline: Sovereign POSIX disk usage estimator tracking inode counts and directory tree weights.
//
// Setup: Demands explicit capability tokens &FsReadCap, &ProcessCap, and &EnvCap under zero ambient authority.
//
// Beats:
//   1. Parse command-line options and dispatch --help, --version, --test, or --mcp.
//   2. Route synthetic showcase requests for --demo execution.
//   3. Execute capability-bounded filesystem capacity analysis.
//   4. Format and output results as POSIX table, top visualizer, or structured JSON Lines.

import "core/du_types.oo";
import "core/du_synthetic.oo";
import "core/du_traversal.oo";
import "render/render_table.oo";
import "render/render_json.oo";
import "render/render_top.oo";
import "ipc/cli_options.oo";
import "ipc/mcp_server.oo";
import "anchor.oo";

fn render_help() -> String {
    return "oodu 0.2.0 (openOODA sovereign storage & capacity)\n"
        + "usage: oodu [options] [PATH]...\n\n"
        + "Estimate file space usage and directory tree weights.\n\n"
        + "Options:\n"
        + "  -a, --all            write counts for all files, not just directories\n"
        + "  -s, --summarize      display only a total for each argument\n"
        + "  -d, --max-depth <N>  print total for directory only if it is N or fewer levels below\n"
        + "  -h, --human-readable print sizes in human readable format (e.g., 1K 234M 2G)\n"
        + "  -k                   like --block-size=1K\n"
        + "  -m                   like --block-size=1M\n"
        + "  -b                   like --apparent-size --block-size=1\n"
        + "      --apparent-size  print apparent sizes rather than disk usage\n"
        + "      --inodes         list inode usage information instead of block usage\n"
        + "      --sort           sort output entries by capacity descending\n"
        + "      --top <N>        show visual breakdown of top N capacity consumers\n"
        + "  -j, --json           output formatted as structured JSON Lines\n"
        + "  -D, --demo           synthetic disk usage analysis demonstration\n"
        + "      --mcp            run as Model Context Protocol stdio server\n"
        + "      --test           run internal verification anchor suite\n"
        + "  -v, --version        output version information and exit\n"
        + "      --help           display this help and exit\n";
}

fn render_version() -> String {
    return "oodu 0.2.0 (openOODA sovereign storage & capacity)\n";
}

pub fn main(
    fr: &FsReadCap,
    pr: &ProcessCap,
    env: &EnvCap,
    args: List[String]
) -> Int {
    let num_args: Int = list_len(args);
    let mut i: Int = 0;

    while i < num_args {
        let arg: String = list_get(args, i);
        if arg == "-h" && num_args == 1 {
            print(render_help());
            return 0;
        }
        if arg == "--help" {
            print(render_help());
            return 0;
        }
        if arg == "-v" || arg == "--version" {
            print(render_version());
            return 0;
        }
        if arg == "--test" {
            if run_all_tests() {
                println("oodu: internal anchor tests PASSED");
                return 0;
            } else {
                println("oodu: internal anchor tests FAILED");
                return 1;
            }
        }
        if arg == "--mcp" {
            run_mcp_server(fr);
            return 0;
        }
        i = i + 1;
    }

    let opts: DuOpts = parse_cli_options(args);

    if opts.demo_mode {
        let tree: List[DuEntry] = build_var_log_tree();
        let mut d_opts: DuOpts = default_du_opts();
        d_opts.human_readable = true;
        if opts.json_mode {
            print(render_json_entries(tree));
        } else {
            print("=== Synthetic Disk Usage Showcase (/var/log) ===\n");
            print(render_table_entries(tree, d_opts, true));
            print("\n");
            print(render_top_breakdown(tree, 5));
        }
        return 0;
    }

    let p_count: Int = list_len(opts.paths);
    let mut p_idx: Int = 0;

    while p_idx < p_count {
        let path: String = list_get(opts.paths, p_idx);
        let tree: List[DuEntry] = get_synthetic_tree(path);
        let filtered: List[DuEntry] = filter_entries(tree, opts);

        if opts.top_limit > 0 {
            print(render_top_breakdown(filtered, opts.top_limit));
        } else if opts.json_mode {
            print(render_json_entries(filtered));
        } else {
            print(render_table_entries(filtered, opts, false));
        }
        p_idx = p_idx + 1;
    }

    return 0;
}
