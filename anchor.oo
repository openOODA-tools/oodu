// # Aggregate Root Substrate Anchor
//
// Logline: Unified test runner aggregating verification anchors from core, render, and ipc subsystems.
//
// Setup: Demands zero ambient authority, links all functional module anchors together.
//
// Beats:
//   1. Execute core module anchor tests for types, sizing, and traversal.
//   2. Execute render module anchor tests for table, JSON Lines, and top visualizers.
//   3. Execute IPC module anchor tests for CLI options and streaming MCP protocol.
//   4. Return aggregate boolean pass/fail status.

import "core/anchor.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";

pub fn run_all_tests() -> Bool {
    if !run_core_tests() {
        return false;
    }
    if !run_render_tests() {
        return false;
    }
    if !run_ipc_tests() {
        return false;
    }
    return true;
}
